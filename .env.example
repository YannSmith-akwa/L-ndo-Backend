# Copiez ce fichier en .env pour le développement local (netlify dev le lit
# automatiquement). En production, configurez ces mêmes variables dans
# Netlify > Project configuration > Environment variables — jamais commitées.

# ── Base de données (Neon) ──────────────────────────────────
# Récupérée dans le tableau de bord Neon après création du projet.
DATABASE_URL=postgresql://user:password@host/londo?sslmode=require

# ── Twilio Verify (envoi des codes OTP par SMS et WhatsApp) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Créé dans Twilio Console > Verify > Services
TWILIO_VERIFY_SERVICE_SID=

# ── MTN MoMo (Collections / Request to Pay) ──────────────────
# Portail : https://momodeveloper.mtn.com — sandbox puis production.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
# URL publique que MTN peut appeler en callback (facultatif si on ne fait
# que du polling, comme actuellement côté client).
MOMO_CALLBACK_HOST=

# ── Orange Money (Web Payment / M Payment) ───────────────────
# Portail : https://developer.orange.com/apis/om-webpay — accès après
# inscription comme marchand Orange Money Cameroun. Les noms exacts des
# champs ci-dessous sont à confirmer dans la documentation fournie une
# fois l'accès marchand obtenu (voir commentaires dans _lib/orange.js).
ORANGE_BASE_URL=https://api.orange.com
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=

# ── Divers ────────────────────────────────────────────────────
# Origine autorisée pour les appels CORS (l'app mobile n'en a pas besoin,
# mais utile si vous testez depuis Snack Web ou un futur site web).
ORIGINE_AUTORISEE=*
